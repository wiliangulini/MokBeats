# Configuração de Ambiente - Produção (VPS)
# Este é um arquivo TEMPLATE - copie para .env na VPS

# Ambiente
NODE_ENV=

# Caminho base para arquivos de audio usado por server/scripts/generate-peaks.js
# VPS: server/scripts/ + ../../assets/audios/
AUDIO_BASE_PATH=

# JWT — gere na VPS com: openssl rand -hex 32
JWT_SECRET=
