{
  "name": "mok-beats-front-end",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build --configuration=production --base-href /",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:focus": "ng run MokBeats_FrontEnd:test-focus --watch=false",
    "cypress:run": "cypress run --browser electron --headless",
    "e2e": "start-server-and-test start http://localhost:4200 cypress:run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/localize": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/material-moment-adapter": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.10.2",
    "bootstrap": "^5.3.8",
    "i18next": "^23.11.5",
    "inputmask": "^5.0.8",
    "jquery": "^3.6.3",
    "moment": "^2.18.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "wavesurfer.js": "^7.8.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "~22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@types/node": "^24.0.0",
    "cypress": "^13.13.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jquery": "^3.6.3",
    "jsdom": "^30.0.1",
    "start-server-and-test": "^2.0.3",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
