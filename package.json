{
  "name": "mok-beats-front-end",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build --configuration=production --base-href /",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:focus": "ng run MokBeats_FrontEnd:test-focus --watch=false --browsers=ChromeHeadless",
    "cypress:run": "cypress run --browser electron --headless",
    "e2e": "start-server-and-test start http://localhost:4200 cypress:run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/cdk": "17.3.10",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/localize": "^17.3.12",
    "@angular/material": "^17.3.10",
    "@angular/material-moment-adapter": "^17.3.10",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "@ng-bootstrap/ng-bootstrap": "^16.0.0",
    "@popperjs/core": "^2.10.2",
    "bootstrap": "^5.3.8",
    "i18next": "^23.11.5",
    "inputmask": "^5.0.8",
    "jquery": "^3.6.3",
    "moment": "^2.18.1",
    "rxjs": "~7.4.0",
    "tslib": "^2.3.0",
    "wavesurfer.js": "^7.8.2",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "~17.3.17",
    "@angular/compiler-cli": "^17.3.12",
    "@types/jasmine": "~4.0.0",
    "@types/node": "^24.0.0",
    "cypress": "^13.13.1",
    "jasmine-core": "~4.2.0",
    "jquery": "^3.6.3",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "start-server-and-test": "^2.0.3",
    "typescript": "~5.4.5"
  }
}